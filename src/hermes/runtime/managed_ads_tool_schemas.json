{
  "propose_ad_child": {
    "$defs": {
      "CauseArgs": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 140,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "signal_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Signal Id"
          },
          "rule_id": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{1,2}\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rule Id"
          }
        },
        "required": [
          "text"
        ],
        "title": "CauseArgs",
        "type": "object"
      },
      "CountryTargetingArgs": {
        "additionalProperties": false,
        "properties": {
          "countries": {
            "items": {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            "maxItems": 25,
            "minItems": 1,
            "title": "Countries",
            "type": "array"
          }
        },
        "required": [
          "countries"
        ],
        "title": "CountryTargetingArgs",
        "type": "object"
      },
      "CpcBidArgs": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "pattern": "^[0-9]{1,6}(\\.[0-9]{1,2})?$",
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "const": "EUR",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "CpcBidArgs",
        "type": "object"
      },
      "GoogleAdGroupNativeArgs": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "type": {
            "const": "SEARCH_STANDARD",
            "title": "Type",
            "type": "string"
          },
          "bidding_strategy": {
            "const": "MANUAL_CPC",
            "title": "Bidding Strategy",
            "type": "string"
          },
          "cpc_bid": {
            "$ref": "#/$defs/CpcBidArgs"
          },
          "targeting_mode": {
            "const": "INHERIT_CAMPAIGN",
            "title": "Targeting Mode",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "bidding_strategy",
          "cpc_bid",
          "targeting_mode"
        ],
        "title": "GoogleAdGroupNativeArgs",
        "type": "object"
      },
      "GoogleAdGroupPlanArgs": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "const": "PAUSED",
            "title": "Status",
            "type": "string"
          },
          "platform": {
            "const": "google",
            "title": "Platform",
            "type": "string"
          },
          "kind": {
            "const": "ad_set",
            "title": "Kind",
            "type": "string"
          },
          "native": {
            "$ref": "#/$defs/GoogleAdGroupNativeArgs"
          }
        },
        "required": [
          "schema_version",
          "status",
          "platform",
          "kind",
          "native"
        ],
        "title": "GoogleAdGroupPlanArgs",
        "type": "object"
      },
      "GoogleRsaNativeArgs": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "RESPONSIVE_SEARCH_AD",
            "title": "Type",
            "type": "string"
          },
          "headlines": {
            "items": {
              "maxLength": 30,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 15,
            "minItems": 3,
            "title": "Headlines",
            "type": "array"
          },
          "descriptions": {
            "items": {
              "maxLength": 90,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 2,
            "title": "Descriptions",
            "type": "array"
          },
          "final_url": {
            "description": "Explicit HTTPS landing page, never fetched by Safent; no credential-bearing URL or private IP.",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Final Url",
            "type": "string"
          }
        },
        "required": [
          "type",
          "headlines",
          "descriptions",
          "final_url"
        ],
        "title": "GoogleRsaNativeArgs",
        "type": "object"
      },
      "GoogleRsaPlanArgs": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "const": "PAUSED",
            "title": "Status",
            "type": "string"
          },
          "platform": {
            "const": "google",
            "title": "Platform",
            "type": "string"
          },
          "kind": {
            "const": "ad",
            "title": "Kind",
            "type": "string"
          },
          "native": {
            "$ref": "#/$defs/GoogleRsaNativeArgs"
          }
        },
        "required": [
          "schema_version",
          "status",
          "platform",
          "kind",
          "native"
        ],
        "title": "GoogleRsaPlanArgs",
        "type": "object"
      },
      "MetaAdNativeArgs": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "creative_id": {
            "pattern": "^[0-9]{1,32}$",
            "title": "Creative Id",
            "type": "string"
          }
        },
        "required": [
          "name",
          "creative_id"
        ],
        "title": "MetaAdNativeArgs",
        "type": "object"
      },
      "MetaAdPlanArgs": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "const": "PAUSED",
            "title": "Status",
            "type": "string"
          },
          "platform": {
            "const": "meta",
            "title": "Platform",
            "type": "string"
          },
          "kind": {
            "const": "ad",
            "title": "Kind",
            "type": "string"
          },
          "native": {
            "$ref": "#/$defs/MetaAdNativeArgs"
          }
        },
        "required": [
          "schema_version",
          "status",
          "platform",
          "kind",
          "native"
        ],
        "title": "MetaAdPlanArgs",
        "type": "object"
      },
      "MetaAdSetNativeArgs": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "budget_mode": {
            "const": "CAMPAIGN",
            "title": "Budget Mode",
            "type": "string"
          },
          "billing_event": {
            "const": "IMPRESSIONS",
            "title": "Billing Event",
            "type": "string"
          },
          "optimization_goal": {
            "const": "LINK_CLICKS",
            "title": "Optimization Goal",
            "type": "string"
          },
          "destination_type": {
            "const": "WEBSITE",
            "title": "Destination Type",
            "type": "string"
          },
          "targeting": {
            "$ref": "#/$defs/MetaChildTargetingArgs"
          },
          "dsa_beneficiary": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Dsa Beneficiary",
            "type": "string"
          },
          "dsa_payor": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Dsa Payor",
            "type": "string"
          }
        },
        "required": [
          "name",
          "budget_mode",
          "billing_event",
          "optimization_goal",
          "destination_type",
          "targeting",
          "dsa_beneficiary",
          "dsa_payor"
        ],
        "title": "MetaAdSetNativeArgs",
        "type": "object"
      },
      "MetaAdSetPlanArgs": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "const": "PAUSED",
            "title": "Status",
            "type": "string"
          },
          "platform": {
            "const": "meta",
            "title": "Platform",
            "type": "string"
          },
          "kind": {
            "const": "ad_set",
            "title": "Kind",
            "type": "string"
          },
          "native": {
            "$ref": "#/$defs/MetaAdSetNativeArgs"
          }
        },
        "required": [
          "schema_version",
          "status",
          "platform",
          "kind",
          "native"
        ],
        "title": "MetaAdSetPlanArgs",
        "type": "object"
      },
      "MetaChildTargetingArgs": {
        "additionalProperties": false,
        "properties": {
          "geo_locations": {
            "$ref": "#/$defs/CountryTargetingArgs"
          },
          "age_min": {
            "maximum": 65,
            "minimum": 18,
            "title": "Age Min",
            "type": "integer"
          },
          "age_max": {
            "maximum": 65,
            "minimum": 18,
            "title": "Age Max",
            "type": "integer"
          },
          "targeting_automation": {
            "$ref": "#/$defs/TargetingAutomationArgs"
          }
        },
        "required": [
          "geo_locations",
          "age_min",
          "age_max",
          "targeting_automation"
        ],
        "title": "MetaChildTargetingArgs",
        "type": "object"
      },
      "TargetingAutomationArgs": {
        "additionalProperties": false,
        "properties": {
          "advantage_audience": {
            "const": 0,
            "title": "Advantage Audience",
            "type": "integer"
          }
        },
        "required": [
          "advantage_audience"
        ],
        "title": "TargetingAutomationArgs",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "entity_ref": {
        "title": "Entity Ref",
        "type": "string"
      },
      "child_plan": {
        "anyOf": [
          {
            "$ref": "#/$defs/GoogleAdGroupPlanArgs"
          },
          {
            "$ref": "#/$defs/GoogleRsaPlanArgs"
          },
          {
            "$ref": "#/$defs/MetaAdSetPlanArgs"
          },
          {
            "$ref": "#/$defs/MetaAdPlanArgs"
          }
        ],
        "title": "Child Plan"
      },
      "cause": {
        "$ref": "#/$defs/CauseArgs"
      }
    },
    "required": [
      "entity_ref",
      "child_plan",
      "cause"
    ],
    "title": "ManagedAdChildArgs",
    "type": "object"
  },
  "list_platform_accounts": {
    "additionalProperties": false,
    "properties": {},
    "title": "EmptyArgs",
    "type": "object"
  },
  "list_campaigns": {
    "additionalProperties": false,
    "properties": {
      "limit": {
        "default": 50,
        "maximum": 50,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "cursor": {
        "anyOf": [
          {
            "maxLength": 1200,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cursor"
      }
    },
    "title": "CampaignsArgs",
    "type": "object"
  },
  "get_entity_metrics": {
    "$defs": {
      "WindowArgs": {
        "additionalProperties": false,
        "description": "`contracts/mcp-tools.md`: `{preset, lag_days}` o `{from, to}`, nunca\nambos ni ninguno.",
        "properties": {
          "preset": {
            "anyOf": [
              {
                "$ref": "#/$defs/WindowPreset"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "lag_days": {
            "default": 0,
            "maximum": 90,
            "minimum": 0,
            "title": "Lag Days",
            "type": "integer"
          },
          "from": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "From"
          },
          "to": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "To"
          }
        },
        "title": "WindowArgs",
        "type": "object"
      },
      "WindowPreset": {
        "enum": [
          "T",
          "3D",
          "7D",
          "14D",
          "30D",
          "MTD"
        ],
        "title": "WindowPreset",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "entity_ref": {
        "maxLength": 1200,
        "minLength": 1,
        "title": "Entity Ref",
        "type": "string"
      },
      "window": {
        "$ref": "#/$defs/WindowArgs"
      },
      "granularity": {
        "default": "daily",
        "enum": [
          "daily",
          "hourly"
        ],
        "title": "Granularity",
        "type": "string"
      }
    },
    "required": [
      "entity_ref",
      "window"
    ],
    "title": "MetricsArgs",
    "type": "object"
  },
  "propose_budget_change": {
    "$defs": {
      "CauseArgs": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 140,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "signal_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Signal Id"
          },
          "rule_id": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{1,2}\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rule Id"
          }
        },
        "required": [
          "text"
        ],
        "title": "CauseArgs",
        "type": "object"
      },
      "EvidenceArgs": {
        "additionalProperties": false,
        "properties": {
          "metric": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Metric",
            "type": "string"
          },
          "actual": {
            "title": "Actual",
            "type": "number"
          },
          "target": {
            "title": "Target",
            "type": "number"
          },
          "window_preset": {
            "$ref": "#/$defs/WindowPreset"
          }
        },
        "required": [
          "metric",
          "actual",
          "target",
          "window_preset"
        ],
        "title": "EvidenceArgs",
        "type": "object"
      },
      "ProposalUrgencyArgs": {
        "enum": [
          "critical",
          "recommended",
          "minor"
        ],
        "title": "ProposalUrgencyArgs",
        "type": "string"
      },
      "WindowPreset": {
        "enum": [
          "T",
          "3D",
          "7D",
          "14D",
          "30D",
          "MTD"
        ],
        "title": "WindowPreset",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "title": "Business Id",
        "type": "string"
      },
      "entity_ref": {
        "title": "Entity Ref",
        "type": "string"
      },
      "new_daily_budget_amount": {
        "pattern": "^\\d+(\\.\\d{1,2})?$",
        "title": "New Daily Budget Amount",
        "type": "string"
      },
      "new_daily_budget_currency": {
        "default": "EUR",
        "pattern": "^[A-Z]{3}$",
        "title": "New Daily Budget Currency",
        "type": "string"
      },
      "cause": {
        "$ref": "#/$defs/CauseArgs"
      },
      "evidence": {
        "items": {
          "$ref": "#/$defs/EvidenceArgs"
        },
        "title": "Evidence",
        "type": "array"
      },
      "urgency": {
        "$ref": "#/$defs/ProposalUrgencyArgs",
        "default": "recommended"
      }
    },
    "required": [
      "business_id",
      "entity_ref",
      "new_daily_budget_amount",
      "cause"
    ],
    "title": "ProposeBudgetChangeArgs",
    "type": "object"
  },
