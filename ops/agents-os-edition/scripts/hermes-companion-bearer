#!/usr/bin/env python3
"""hermes-companion-bearer — stage companion secrets where the daemon can read them
(024 bearer, 026 SSO private key).

The same root stage validates the source registry explicitly and publishes only
accepted endpoints at /run/hermes/companions/companions.json (0440 root:hermes).
Source files live on the launcher's read-only Linux-volume projection, NOT a
raw virtiofs bind whose caller-dependent owner can make secrets readable by an
unprivileged process. The daemon never falls back to a source registry.

WHY A SHIM AND NOT A MODE/GROUP CHANGE ON THE HOST FILE
------------------------------------------------------
`read_companion_bearer` runs INSIDE hermes-runtime.service, i.e. as uid 880
(`hermes`). The bearer it must read is a HOST file bind-mounted read-only by
run-safent.sh, written 0400 by provision.sh. Its uid/gid inside the container
is whatever the engine's mapping produces — 0:0 under rootless podman/docker
(the installing owner is remapped to root), 1000:1000 under ROOTFUL podman (no
remapping at all). NEITHER is `hermes`, and no host-side `chown`/`chmod` can
make it so portably: gid 880 on the host is some unrelated group, and widening
the mode to 0444 would hand the bearer to uid 886 (`hermes-sandbox`, the
agent/MCP sandbox) — exactly the process the bearer must be kept from.

So a root stage-in is the only correct shape. This runs as the FULL-privilege
`ExecStartPre=-+` of hermes-runtime.service (the `+` prefix, same pattern as
`_provision_bootstrap_secret` and hermes-mcp-cache-sync), reads each validated
companion's bearer, and drops a copy on TMPFS at

    /run/hermes/companions/<slug>.bearer   0440 root:hermes

readable by the daemon's group and by nobody else (hermes-sandbox is not in
group `hermes`). tmpfs => gone on reboot, re-staged from the mount every boot,
so a rotated bearer takes effect on the next boot with no extra plumbing and
no copy is ever persisted to disk (INV-4).

The 026 SSO private key (`/etc/hermes/companions/ads-sso.key`, contracts/
sso.md §3, provisioned 0400 by provision.sh's `ensure_sso_keypair`) has the
EXACT same problem — `CompanionSsoAuthority` runs inside this same daemon
process, same uid 880, same unreadable-mount shape — so this script stages
it too, at

    /run/hermes/companions/ads-sso.key   0440 root:hermes

Fixed path, not per-slug (there is exactly one companion today). Before this,
`MintCompanionOwnerAssertion` read the raw mount directly and always raised
`PermissionError` — `/ads/*` 503'd on every request (ADS-02).

Exit code is ALWAYS 0 — a companion is optional infrastructure and this must
never block the daemon's boot (FR-3). The unit also uses `-` for the same
reason; both belts, on purpose.
"""

from __future__ import annotations

import grp
import json
import os
import sys
import tempfile
from contextlib import suppress
from dataclasses import asdict
from pathlib import Path

from hermes.shell_server.companions import (  # noqa: E402
    COMPANION_RUNTIME_BEARER_DIR,
    COMPANION_RUNTIME_REGISTRY_PATH,
    COMPANION_RUNTIME_SSO_KEY_PATH,
    COMPANION_SOURCE_REGISTRY_PATH,
    COMPANION_SSO_KEY_MOUNT_PATH,
    load_companions,
    read_companion_bearer,
    runtime_bearer_path,
)

_DAEMON_GROUP = "hermes"


def main() -> int:
    gid = grp.getgrnam(_DAEMON_GROUP).gr_gid
    _ensure_dir(gid)
    # Remove the previous authority snapshot before reading a rotated source.
    # Optional infrastructure may fail to stage, but stale credentials must not
    # survive that failure. Publish the new registry LAST.
    _purge_runtime(gid)
    try:
        return _stage(gid)
    except Exception:
        _purge_runtime(gid)
        raise


def _stage(gid: int) -> int:
    endpoints = load_companions(path=COMPANION_SOURCE_REGISTRY_PATH)
    staged = 0
    accepted = []
    for slug, endpoint in sorted(endpoints.items()):
        # prefer_runtime_copy=False: read the read-only MOUNT, never the copy
        # this script itself wrote on a previous boot (which would make a
        # rotated bearer invisible until the tmpfs is cleared).
        bearer = read_companion_bearer(endpoint, prefer_runtime_copy=False)
        if not bearer:
            print(f"[companion-bearer] {slug}: no bearer at its bearer_ref", file=sys.stderr)
            continue
        _write_secret(runtime_bearer_path(slug), bearer, gid)
        accepted.append(asdict(endpoint))
        staged += 1
    sso_staged = _stage_sso_key(gid) if accepted else 0
    if accepted:
        _write_secret(
            str(COMPANION_RUNTIME_REGISTRY_PATH),
            json.dumps({"version": 1, "companions": accepted}, sort_keys=True),
            gid,
        )
    print(
        f"[companion-bearer] {staged} bearer(s), {sso_staged} sso key(s) "
        f"staged for uid/gid {_DAEMON_GROUP}"
    )
    return 0


def _purge_runtime(gid: int) -> None:
    _remove_if_present(str(COMPANION_RUNTIME_REGISTRY_PATH))
    _purge_stale(set(), gid)
    _remove_if_present(COMPANION_RUNTIME_SSO_KEY_PATH)


def _stage_sso_key(gid: int) -> int:
    """Copy the 026 SSO private key from its read-only mount, same as a
    bearer. Reads the mount directly (never a previous boot's staged copy —
    same rotation argument as `prefer_runtime_copy=False` above). Absent
    mount (no companion, or provisioning failed, FR-3) => purge any stale
    copy and stage nothing; never raises (caller is fail-soft)."""
    try:
        key = Path(COMPANION_SSO_KEY_MOUNT_PATH).read_text(encoding="utf-8").strip()
    except OSError:
        key = ""
    if not key:
        _remove_if_present(COMPANION_RUNTIME_SSO_KEY_PATH)
        print("[companion-bearer] no SSO key at its mount", file=sys.stderr)
        return 0
    _write_secret(COMPANION_RUNTIME_SSO_KEY_PATH, key, gid)
    return 1


def _remove_if_present(path: str) -> None:
    with suppress(OSError):
        os.remove(path)


def _ensure_dir(gid: int) -> None:
    os.makedirs(COMPANION_RUNTIME_BEARER_DIR, exist_ok=True)
    if Path(COMPANION_RUNTIME_BEARER_DIR).is_symlink():
        raise ValueError("staging directory must not be a symlink")
    os.chown(COMPANION_RUNTIME_BEARER_DIR, 0, gid)
    os.chmod(COMPANION_RUNTIME_BEARER_DIR, 0o750)  # noqa: S103 — root:hermes, no other access


def _write_secret(path: str, value: str, gid: int) -> None:
    fd, tmp = tempfile.mkstemp(prefix=".companion-", dir=Path(path).parent)
    try:
        os.fchown(fd, 0, gid)
        os.fchmod(fd, 0o440)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            fd = -1
            stream.write(value)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, path)
    finally:
        if fd != -1:
            os.close(fd)
        _remove_if_present(tmp)


def _purge_stale(live_slugs: set[str], _gid: int) -> None:
    """A companion the owner removed must not leave its bearer behind."""
    try:
        names = os.listdir(COMPANION_RUNTIME_BEARER_DIR)
    except OSError:
        return
    for name in names:
        if not name.endswith(".bearer"):
            continue
        if name[: -len(".bearer")] in live_slugs:
            continue
        _remove_if_present(os.path.join(COMPANION_RUNTIME_BEARER_DIR, name))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # noqa: BLE001 — never block the daemon's boot
        print(f"[companion-bearer] failed (non-fatal): {exc}", file=sys.stderr)
        sys.exit(0)
