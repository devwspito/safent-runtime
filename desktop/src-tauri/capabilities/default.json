{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Safent desktop — core IPC for the local loader window (install button).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-cancel-bootstrap",
    "allow-retry-bootstrap",
